# ============================================================
# SHADOW VOLUME ALERT - settings
# Copy this file to config.env and fill in the two Telegram lines:
#     cp config.example.env config.env
#     nano config.env
# Lines starting with # are comments. No spaces around "=" needed.
# ============================================================

# --- Your personal credentials (REQUIRED) ---
# From @BotFather, looks like 1234567890:AAH...xyz
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
# Your user/group/channel chat id, e.g. 123456789 or -1001234567890
TELEGRAM_CHAT_ID=PUT_YOUR_CHAT_ID_HERE

# --- Alert rules (defaults match the spec) ---
SCAN_INTERVAL_SECONDS=300
MIN_VOLUME_5M_USD=10000
MIN_LIQUIDITY_USD=10000
MIN_TXNS_5M=20
VOLUME_MULTIPLIER=2.5

# Ignore comparisons when the previous 5m volume was below this (avoids silly 500x from $5)
MIN_PREVIOUS_VOLUME_USD=100

# Previous reading must be this old (seconds) to count as "the previous 5 minutes".
# Older readings (phone slept, bot was off) are NOT compared -> no fake signals.
MIN_READING_GAP_SECONDS=240
MAX_READING_GAP_SECONDS=420

# Same pool/coin will not alert again for this many minutes
ALERT_COOLDOWN_MINUTES=60

# Pools seen trending keep being watched this many hours
WATCHLIST_HOURS=3
MAX_POOLS_PER_SCAN=450
# GeckoTerminal trending pages to read (20 pools per page)
GT_TRENDING_PAGES=3

# Confirm every alert with an independent second source (GeckoTerminal)
CROSS_CHECK_GECKOTERMINAL=true
# GeckoTerminal numbers must be at least this fraction of the thresholds
CROSS_CHECK_TOLERANCE=0.5

SEND_STARTUP_MESSAGE=true

# Base-token symbols that are NOT meme coins (never alerted). Comma separated.
# Leave this line out to use the built-in list (SOL, stablecoins, BTC/ETH/ZEC wrappers, JUP, RAY, ...).
#EXCLUDE_SYMBOLS=SOL,USDC,USDT,ZEC,WBTC,WETH,JUP

# --- Safety & buy pressure (v1.1) ---
# Every alert shows a free RugCheck safety check (risk level, mint/freeze authority, top risks).
# true = do not send alerts for HIGH-risk / rugged tokens (mint or freeze authority enabled, danger risks)
SKIP_HIGH_RISK=false
# Minimum buys/sells ratio in the last 5 min (e.g. 1.5 = 50% more buys than sells). 0 = off
MIN_BUY_RATIO=0
